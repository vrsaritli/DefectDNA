# Copy to .env and fill values. Never commit .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=defectdna
SERVICE_TOKEN_SECRET=replace-with-a-long-random-secret
INGESTION_SERVICE_URL=http://127.0.0.1:8001
MAX_IMPORT_FILE_BYTES=10485760
MAX_IMPORT_ROWS=5000
SESSION_SIGNING_KEY=replace-with-at-least-32-random-bytes
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
SESSION_IDLE_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_REQUESTS_PER_MINUTE=120

ADO_ORGANIZATION_URL=https://dev.azure.com/rathna070
ADO_PROJECT=SAmple demo
ADO_PAT=
