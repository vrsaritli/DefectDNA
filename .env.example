# Copy to .env and fill values. Never commit .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=defectdna
SERVICE_TOKEN_SECRET=replace-with-a-long-random-secret
INGESTION_SERVICE_URL=http://127.0.0.1:8001
MAX_IMPORT_FILE_BYTES=10485760
MAX_IMPORT_ROWS=5000
SESSION_SIGNING_KEY=replace-with-at-least-32-random-bytes
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
SESSION_IDLE_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_REQUESTS_PER_MINUTE=120

ADO_ORGANIZATION_URL=https://dev.azure.com/rathna070
ADO_PROJECT=SAmple demo
ADO_PAT=
TEST_USER_EMAIL=

# Phase 4 — AI RCA (Groq). Real key goes in .env only.
ENV=dev
AI_KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8002
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
LLM_DAILY_CALL_CAP=500
LLM_REQUEST_TOKEN_BUDGET=4500
LLM_BATCH_TARGET_TOKENS=4000
LLM_OUTPUT_TOKENS_PER_DEFECT=400
LLM_MAX_DEFECTS_PER_BATCH=8
MAX_ANALYSIS_BATCH=200

# Phase 5 — Knowledge Base and RAG (Cohere). Real key goes in .env only.
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_EMBED_DIMENSIONS=1024
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
